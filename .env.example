# =====================================================================
# CIVIL REGISTRY ONLINE SERVICES PORTAL - FIREBASE ENVIRONMENT TEMPLATE
# =====================================================================

# 1. Firebase Client Configuration (Web + Mobile App Config)
FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
FIREBASE_AUTH_DOMAIN="civil-registry-portal-demo.firebaseapp.com"
FIREBASE_PROJECT_ID="civil-registry-portal-demo"
FIREBASE_STORAGE_BUCKET="civil-registry-portal-demo.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
FIREBASE_VAPID_KEY="BYourPublicWebPushVapidKeyForFCM"

# 2. Cloud Functions Secret Manager (NEVER expose to client)
# Set via: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY="your-gemini-api-key-here"

# 3. Local Development Server / Emulator Ports
PORT=5000
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
